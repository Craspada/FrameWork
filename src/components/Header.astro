---
import { navegacion } from "../data/navegacion";  
const currentPath = Astro.url.pathname.replace(/\/+$/, '') || '/';
---

<header>
    <div class="header-inner">
        <a class="brand" href="/" aria-label="ExtinPro, ir al inicio">
            <img id="logo" src="/img/logo_ExtinPro.png" alt="ExtinPro">
        </a>

        <button
            id="boton_menu"
            type="button"
            aria-expanded="false"
            aria-controls="navegacion-principal"
            aria-label="Abrir menú"
        >
            <span></span>
            <span></span>
            <span></span>
        </button>

        <nav id="navegacion-principal" class="nav-links" aria-label="Navegación principal">
            {navegacion.map(({ href, label }) => (
                <a
                    href={href}
                    aria-current={currentPath === href ? 'page' : undefined}
                >
                    {label}
                </a>
            ))}
            <a class="nav-cta" href="/contacto">Hablemos</a>
        </nav>

        <button type="button" id="boton-carrito" class="boton-carrito" aria-label="Abrir carrito">
            <svg viewBox="0 0 24 24" width="24" height="24" aria-hidden="true" focusable="false"
                fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <circle cx="9" cy="20" r="1.5"></circle>
                <circle cx="18" cy="20" r="1.5"></circle>
                <path d="M2 3h3l2.7 12.4a1 1 0 0 0 1 .8h9.6a1 1 0 0 0 1-.8L21 7H6"></path>
            </svg>
            <span id="contador-carrito" class="contador-carrito" hidden>0</span>
        </button>        
    </div>
</header>

<script>
    const menuButton = document.querySelector<HTMLButtonElement>('#boton_menu');
    const navigationMenu = document.querySelector<HTMLElement>('#navegacion-principal');

    if (menuButton && navigationMenu) {
        const closeMenu = () => {
            menuButton.setAttribute('aria-expanded', 'false');
            menuButton.setAttribute('aria-label', 'Abrir menú');
            navigationMenu.classList.remove('nav-activo');
        };

        menuButton.addEventListener('click', () => {
            const isExpanded = menuButton.getAttribute('aria-expanded') === 'true';
            menuButton.setAttribute('aria-expanded', String(!isExpanded));
            menuButton.setAttribute('aria-label', isExpanded ? 'Abrir menú' : 'Cerrar menú');
            navigationMenu.classList.toggle('nav-activo', !isExpanded);
        });

        navigationMenu.querySelectorAll('a').forEach((link) => {
            link.addEventListener('click', closeMenu);
        });

        document.addEventListener('keydown', (event) => {
            if (event.key === 'Escape') closeMenu();
        });
    }
</script>

<script>
    import { totalCantidad } from "../data/carrito";

    const botonCarrito = document.querySelector<HTMLButtonElement>('#boton-carrito');
    const contador = document.querySelector<HTMLSpanElement>('#contador-carrito');

    function actualizar() {
        if (!botonCarrito || !contador) return;

        const n = totalCantidad();
        contador.textContent = String(n);
        contador.hidden = n === 0;
        botonCarrito.setAttribute('aria-label', `Abrir carrito, ${n} ${n === 1 ? 'unidad' : 'unidades'}`);
    }

    window.addEventListener('carrito-cambio', actualizar);
    window.addEventListener('storage', actualizar);
    actualizar();

    botonCarrito?.addEventListener('click', () => {
        document.querySelector<HTMLDialogElement>('#carrito')?.showModal();
    });
</script>