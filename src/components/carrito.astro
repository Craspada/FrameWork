<dialog id="carrito" class="carrito-lateral" aria-labelledby="carrito-titulo">
    <header class="carrito-cabecera">
        <h2 id="carrito-titulo">Tu Carrito</h2>
        <button type="button" id="cerrar-carrito" aria-label="cerrar carrito">✕</button>
    </header>

    <p id="carrito-vacio">Tu carrito está vacío.</p>
    <ul id="carrito-lista" class="carrito-lista"></ul>

    <footer class="carrito-pie">
        <dl class="resumen-datos"> ... subtotal, descuento, total ... </dl>
        <p id="aviso-descuento"></p>
        <button type="button" id="finalizar-compra">Finalizar Compra</button>
        <p id="mensaje-compra" role="status"></p>
    </footer>
</dialog>