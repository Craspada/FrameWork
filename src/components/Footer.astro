---
import { navegacion } from '../data/navegacion';
---

<footer>
    <div class="footer-main">
        <section class="footer-brand" aria-labelledby="footer-title">
            <a class="footer-logo" href="/" aria-label="ExtinPro, ir al inicio">
                <img src="/img/logo_ExtinPro.png" alt="ExtinPro">
            </a>
            <h2 id="footer-title">Protección que da tranquilidad.</h2>
            <p>Soluciones para la prevención y protección contra incendios.</p>
        </section>

        <nav class="footer-links" aria-label="Enlaces del sitio">
            <h2>Explora</h2>
            {navegacion.map(({ href, label }) => <a href={href}>{label}</a>)}
            <a href="/politica-privacidad">Política de privacidad</a>
        </nav>

        <section class="footer-contact" aria-labelledby="footer-contact-title">
            <h2 id="footer-contact-title">¿Necesitas asesoría?</h2>
            <p>Conoce nuestras soluciones y encuentra la opción adecuada para ti.</p>
            <a class="footer-cta" href="/contacto">
                Contáctanos <span aria-hidden="true">→</span>
            </a>
        </section>
    </div>

    <div class="footer-bottom">
        <p>&copy; {new Date().getFullYear()} ExtinPro y Asociados. Todos los derechos reservados.</p>
        <a href="/politica-privacidad">Política de privacidad</a>
    </div>
</footer>