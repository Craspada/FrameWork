---
import Layout from "../layouts/Layout.astro";
---

<Layout title="ExtinPro | Ingresar">
    <section id="Login" class="contenedor">
        <h1>Ingresar</h1>

        <form id="form-login" class="formulario" novalidate>
            <label for="id-cliente">N° Cliente</label>
            <input id="id-cliente" name="id_cliente" type="number" min="1" required autocomplete="username">

            <label for="contrasena" class="contenedor">Contraseña</label>
            <input id="contrasena" name="contrasena" type="password" required autocomplete="current-password">

            <p id="mensaje" class="mensaje-error" role="alert"></p>

            <button type="submit" class="boton">Ingresar</button>
        </form>

        <div id="panel-cuenta" class="panel-cuenta" hidden>
            <h2 id="saludo"></h2>
            <p id="detalle"></p>
            <button type="button" id="boton-salir" class="boton">Cerrar sesión</button>
        </div>
    </section>
</Layout>

<script>
    import { usuarios} from "../data/usuarios";

    const form = document.querySelector<HTMLFormElement>('#form-login');
    const panel = document.querySelector<HTMLElement>('#panel-cuenta');
    const saludo = document.querySelector<HTMLElement>('#saludo');
    const detalle = document.querySelector<HTMLElement>('#detalle');
    const mensaje = document.querySelector<HTMLElement>('#mensaje');
    const botonSalir = document.querySelector<HTMLElement>('#boton-salir');

    function mostrar() {
        if (!form || !panel || !saludo || !detalle) return;
        const guardada = sessionStorage.getItem('sesion');

        if (guardada) {
            const sesion = JSON.parse(guardada);
            saludo.textContent = `Hola, ${sesion.nombre}`;
            detalle.textContent =
                `Tu descuento es del ${sesion.descuento}%` +
                (sesion.prioritaria ? '. Tienes atención prioritaria.' : '');
            form.hidden = true;
            panel.hidden = false;
        } else {
            form.hidden = false;
            panel.hidden = true;
        }
    }
    form?.addEventListener('submit', (evento) => {
        evento.preventDefault();
        const datos = new FormData(form);
        const id = Number(datos.get('id_cliente'));
        const clave = String(datos.get('contrasena'));

        const usuario = usuarios.find(
            (u) => u.id_cliente === id && u.contrasena === clave
        );

        if (!usuario) {
            if (mensaje) mensaje.textContent = 'N° de cliente o contraseña incorrectos.';
            return;
        }

        if (mensaje) mensaje.textContent = '';
        // Se guarda solo lo necesario, nunca la contraseña.
        sessionStorage.setItem('sesion', JSON.stringify({
            nombre: usuario.Nombre_apellido,
            descuento: usuario.descuento,
            prioritaria: usuario.atencion_prioritaria,
        }));
        form.reset();
        mostrar();
    });

    botonSalir?.addEventListener('click', () => {
        sessionStorage.removeItem('sesion');
        mostrar();
    });

    mostrar();
</script>