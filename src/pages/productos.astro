---
import Layout from '../layouts/Layout.astro';
import { productos } from '../data/productos.js';
---

<Layout title="ExtinPro | Nuestros Productos">
    <div class="grilla-productos">
        {productos.map(p =>(
            <article class="tarjeta">
                <h2>{p.nombre}</h2>
                <p>{p.tipo} · {p.tamano}</p>
                <p>{p.precio.toLocaleString('es-CL', { style: 'currency', currency: 'CLP' })}</p>
            </article>
        ))}
    </div>
</Layout>
