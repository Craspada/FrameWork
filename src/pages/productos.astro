---
import Layout from '../layouts/Layout.astro';
import { productos } from '../data/productos.ts';
---

<Layout title="ExtinPro | Nuestros Productos">
    <section id="Productos" class="contenedor">
        <h1>Nuestros Productos</h1>
        <div class="grilla-productos">
            {productos.map(p =>(
                <article class="tarjeta">
                    <h2>{p.nombre}</h2>
                    <p>{p.tipo} · {p.tamano}</p>
                    <p>{p.precio.toLocaleString('es-CL', { style: 'currency', currency: 'CLP' })}</p>
                </article>
            ))}
        </div>        
    </section>
</Layout>
